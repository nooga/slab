{"slab": "preset", "schema": 1, "machine": "fxrack", "note": "Big and gnarly: a clean low-passed sub lane under a lane of octave-down, dynamic folding, RAT and OTT. SIZE is the sub, GNARL the dirt.", "rack": 2, "kind": "effect", "lanes": [{"name": "SUB", "effects": [{"machine": "wob2", "params": {"wob-type": 0, "wob-cutoff": 140, "wob-res": 0.0, "wob-morph": 0, "wob-slope": 1, "wob-drive": 0, "wob-source": 3, "wob-depth": 0.0, "wob-amp": 0, "wob-glide": 0, "wob-pos": 0.0, "wob-shape": 0, "wob-rate": 2, "wob-sync": 1, "wob-div": 5, "wob-phase": 0, "wob-spread": 0, "wob-retrig": 0, "wob-s1": 1, "wob-s2": 0, "wob-s3": 0.5, "wob-s4": 0, "wob-s5": 1, "wob-s6": 0, "wob-s7": 0.75, "wob-s8": 0.25, "wob-s9": 1, "wob-s10": 0, "wob-s11": 0.5, "wob-s12": 0.25, "wob-s13": 1, "wob-s14": 0.5, "wob-s15": 0.75, "wob-s16": 0, "wob-length": 16, "wob-sens": 12, "wob-atk": 0.0049999999999999975, "wob-rel": 0.1499999999999999, "wob-mix": 1, "wob-out": 0}, "bypass": false, "preset": "pedal-wah"}, {"machine": "sat2", "params": {"sat-mode": 1, "sat-drive": 6}, "bypass": false}]}, {"name": "GNARL", "effects": [{"machine": "eq2", "params": {"eq-hpf-on": 1, "eq-hpf-hz": 160}, "bypass": false}, {"machine": "oct2", "params": {"oct-track": 600, "oct-glitch": 0, "oct-thresh": -50, "oct-mode": 1, "oct-oct1": 0.5, "oct-cut1": 700, "oct-res1": 0.19999999999999996, "oct-oct2": 0, "oct-cut2": 350, "oct-res2": 0.19999999999999996, "oct-up": 0, "oct-fuzz": 0.5, "oct-direct": 1.0, "oct-out": 0}, "bypass": false, "preset": "oc-sub"}, {"machine": "fold2", "params": {"fold-fold": 10, "fold-symm": 0, "fold-shape": 0, "fold-dyn": 0.8, "fold-stages": 0, "fold-tight": 20, "fold-tone": 16000, "fold-auto": 1, "fold-mix": 1, "fold-out": 0}, "bypass": false, "preset": "dynamic-fold"}, {"machine": "grind2", "params": {"grind-algo": 1, "grind-drive": 34, "grind-bias": 0, "grind-stages": 0, "grind-lo-hz": 300, "grind-lo-db": -9, "grind-hi-hz": 1200, "grind-hi-db": 5, "grind-sizzle": 0, "grind-flux": 0, "grind-phase": 0, "grind-tone": 4500, "grind-auto": 1, "grind-clip": 1, "grind-mix": 1, "grind-out": 0}, "bypass": false, "preset": "rat"}, {"machine": "multi2", "params": {"multi-xlo": 88, "multi-xhi": 2500, "multi-atk": 0.0135, "multi-rel": 0.132, "multi-up": 1.5, "multi-mix": 0.7, "multi-out": 6, "mlo-ratio": 66.7, "mlo-gain": 10.3, "mlo-thresh": -26, "mmid-ratio": 66.7, "mmid-gain": 5.7, "mmid-thresh": -26, "mhi-ratio": 100, "mhi-gain": 10.3, "mhi-thresh": -29}, "bypass": false, "preset": "ott"}], "level": -5}], "macros": [{"name": "SIZE", "value": 0.7}, {"name": "GNARL", "value": 0.5}, {"name": "FOLD", "value": 0.4}, {"name": "SQUASH", "value": 0.7}, {"name": "", "value": 0.0}, {"name": "", "value": 0.0}, {"name": "", "value": 0.0}, {"name": "", "value": 0.0}], "chain": 0, "maps": [{"macro": 1, "lane": 1, "target": "level", "min": -30.0, "max": 0.0}, {"macro": 2, "lane": 2, "insert": 4, "control": "grind-drive", "min": 14.0, "max": 44.0}, {"macro": 3, "lane": 2, "insert": 3, "control": "fold-fold", "min": 0.0, "max": 24.0}, {"macro": 4, "lane": 2, "insert": 5, "control": "multi-mix", "min": 0.0, "max": 1.0}], "collapsed": true}