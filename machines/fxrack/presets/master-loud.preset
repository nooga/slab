{"slab": "preset", "schema": 1, "machine": "fxrack", "note": "A loudness stage for the master: GLUE compresses, CLIP rounds off the peaks, then a limiter at CEIL. LOUD drives the clip and the limiter together, so it gets denser, not just louder.", "rack": 2, "kind": "effect", "lanes": [{"name": "MASTER", "effects": [{"machine": "comp2", "params": {"comp-thresh": -12, "comp-ratio": 2, "comp-knee": 8, "comp-atk": 0.01, "comp-rel": 0.15, "comp-hpf": 80, "comp-det": 1, "comp-makeup": 0, "comp-mix": 1}}, {"machine": "sat2", "params": {"sat-drive": 4, "sat-mode": 3, "sat-sag": 0, "sat-color": 1, "sat-tone": 18000, "sat-mix": 0.5, "sat-out": -2}}, {"machine": "limiter2", "params": {"lim-gain": 8, "lim-ceil": -1.0, "lim-look": 2, "lim-rel": 0.12}}]}], "macros": [{"name": "LOUD", "value": 0.5}, {"name": "GLUE", "value": 0.4}, {"name": "CLIP", "value": 0.5}, {"name": "CEIL", "value": 0.6}, {"name": "", "value": 0}, {"name": "", "value": 0}, {"name": "", "value": 0}, {"name": "", "value": 0}], "chain": 0, "maps": [{"macro": 1, "lane": 1, "insert": 3, "control": "lim-gain", "min": 0, "max": 16}, {"macro": 1, "lane": 1, "insert": 2, "control": "sat-drive", "min": 0, "max": 9}, {"macro": 1, "lane": 1, "insert": 2, "control": "sat-out", "min": 0, "max": -5}, {"macro": 2, "lane": 1, "insert": 1, "control": "comp-thresh", "min": -3, "max": -22}, {"macro": 2, "lane": 1, "insert": 1, "control": "comp-makeup", "min": 0, "max": 3}, {"macro": 3, "lane": 1, "insert": 2, "control": "sat-mix", "min": 0, "max": 1}, {"macro": 4, "lane": 1, "insert": 3, "control": "lim-ceil", "min": -3, "max": -0.3}]}