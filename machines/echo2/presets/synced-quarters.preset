{
  "slab": "preset",
  "schema": 1,
  "machine": "echo2",
  "note": "A one-bar loop in time: the heads fall on the quarters",
  "params": {
    "echo-length": 0.5,
    "echo-speed": 1,
    "echo-sync": 1,
    "echo-div": 4.0,
    "echo-h1": 1,
    "echo-h2": 1,
    "echo-h3": 1,
    "echo-h4": 1,
    "echo-mode": 0,
    "echo-spread": 1.0,
    "echo-repeat": 0.55,
    "echo-tone": 5000,
    "echo-drive": 0.25,
    "echo-freeze": 0,
    "echo-wow": 0.15,
    "echo-flutter": 0.2,
    "echo-hiss": 0.2,
    "echo-pops": 0.1,
    "echo-wear": 0.1,
    "echo-mix": 0.3
  }
}
