    "echo-h4": 1,
    "echo-mode": 1,
    "echo-spread": 0.8,
    "echo-repeat": 0.95,
    "echo-tone": 3200,
    "echo-drive": 0.35,
    "echo-freeze": 0,
    "echo-wow": 0.4,
    "echo-flutter": 0.35,
    "echo-hiss": 0.3,
    "echo-pops": 0.15,
    "echo-wear": 0.2,
    "echo-mix": 0.4
  }
