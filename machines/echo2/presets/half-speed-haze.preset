    "echo-spread": 0.9,
    "echo-repeat": 0.85,
    "echo-tone": 5000,
    "echo-drive": 0.3,
    "echo-freeze": 0,
    "echo-wow": 0.45,
    "echo-flutter": 0.3,
    "echo-hiss": 0.35,
    "echo-pops": 0.25,
    "echo-wear": 0.3,
    "echo-mix": 0.4
  }
