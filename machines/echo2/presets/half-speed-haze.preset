{
  "slab": "preset",
  "schema": 1,
  "machine": "echo2",
  "note": "The motor at half speed: long, dark, an octave of travel when you move SPEED",
  "params": {
    "echo-length": 0.6,
    "echo-speed": 0.5,
    "echo-sync": 0,
    "echo-h1": 1,
